{
    "actorSpecification": 1,
    "name": "daily-job-pulse",
    "title": "Daily Job Pulse — Multi-Source Job Aggregator (24+ Platforms)",
    "description": "Scans 24+ job platforms daily (Indeed, Glassdoor, RemoteOK, Naukri, LinkedIn, WeWorkRemotely, and more) and aggregates job opportunities with direct apply links. Features interactive dashboard, smart deduplication, and multi-format export. No API keys required.",
    "version": "2.0.0",
    "buildTag": "latest",
    "meta": {
        "templateId": "js-crawlee-cheerio"
    },
    "input": "./input_schema.json",
    "output": "./output_schema.json",
    "dockerfile": "../Dockerfile",
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "title": "Job Listings Dataset",
            "views": {
                "jobs": {
                    "title": "Job Opportunities",
                    "transformation": {
                        "fields": [
                            "jobTitle",
                            "company",
                            "location",
                            "source",
                            "jobType",
                            "postedDate",
                            "applyLink"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "jobTitle": { "label": "Job Title", "format": "text" },
                            "company": { "label": "Company", "format": "text" },
                            "location": { "label": "Location", "format": "text" },
                            "source": { "label": "Source", "format": "text" },
                            "jobType": { "label": "Type", "format": "text" },
                            "postedDate": { "label": "Posted", "format": "text" },
                            "applyLink": { "label": "Apply", "format": "link" }
                        }
                    }
                }
            }
        }
    }
}