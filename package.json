    "description": "Multi-Source Job Opportunity Aggregator - Scans 24+ job platforms daily and aggregates job opportunities with direct apply links",
    "type": "module",
    "main": "src/main.js",
    "scripts": {
        "start": "node src/main.js",
        "start:dev": "APIFY_DEV=1 node src/main.js",
